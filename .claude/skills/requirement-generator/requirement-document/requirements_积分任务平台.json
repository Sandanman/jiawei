        {"step": 4, "actor": "用户", "action": "浏览任务广场 → 选择任务 → 接单"},
        {"step": 5, "actor": "用户", "action": "完成任务 → 提交成果（图片/文字/截图）"},
        {"step": 6, "actor": "商家", "action": "审核提交（通过/拒绝）"},
        {"step": 7, "actor": "平台系统", "action": "审核通过 → 积分立即发放到用户可用积分"},
        {"step": 8, "actor": "平台系统", "action": "每日02:00 → 检查过期积分 → 自动扣除"},
