# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jiawei

# JWT 密钥（后续使用）
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI 大模型调用配置（v1.1 地域化三餐推荐）
AI_API_URL=your_ai_api_url_here
AI_API_KEY=your_ai_api_key_here
AI_MODEL=your_ai_model_here
AI_TIMEOUT_MS=10000

# 腾讯位置服务 Key（地域化推荐：逆地理编码 + IP 定位，仅服务端使用）
TENCENT_MAP_KEY=your_tencent_map_key_here
MAP_TIMEOUT_MS=5000

# 管理后台（admin-console）
# 独立 JWT 密钥，生产环境必填，留空将启动失败
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
ADMIN_JWT_EXPIRES_IN=8h
# 允许访问 /api/admin 的来源，逗号分隔，开发默认 http://localhost:5173
ADMIN_CORS_ORIGINS=http://localhost:5173
