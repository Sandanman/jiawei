{
    "compilerOptions": {
        "composite": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": false,
        "emitDeclarationOnly": true,
        "declaration": true,
        "outDir": "node_modules/.tmp",
        "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "types": [
            "node"
        ]
    },
    "include": [
        "vite.config.ts"
    ]
}
